{
  "name": "a10-knowledge-graph",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A10 课程知识图谱智能构建与学习导航系统 (Next.js 全栈 / tier1 框架)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "node scripts/check-connectivity.mts",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.65",
    "@ai-sdk/google": "^4.0.82",
    "@ai-sdk/openai": "^4.0.78",
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@ai-sdk/react": "^4.0.121",
    "ai": "^7.0.118",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.2",
    "neo4j-driver": "^6.2.0",
    "next": "^16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",

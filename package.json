    "@types/react-dom": "^19.0.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "autocannon": "^8.0.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.7",
    "geist": "^1.7.2",
    "postcss": "^8.5.3",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }

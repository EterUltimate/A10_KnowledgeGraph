# ===== Neo4j 图数据库（对应 A10.md 六、七节）=====
# 默认本地连接地址；用户名通常为 neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# ===== LLM API（OpenAI 兼容，对应 A10.md 八、九节）=====
# 建议使用 DeepSeek / Qwen 等 OpenAI 兼容接口
# 注意：API Key 只放 .env，不要写进源码，也不要提交 Git
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 应用配置（可选）=====
# RAG 检索返回的最相关文本块数量（A10.md 十五节建议 3-5）
RAG_TOP_K=4
# 文本切块大小（字），A10.md 建议 500-1000
RAG_CHUNK_SIZE=800

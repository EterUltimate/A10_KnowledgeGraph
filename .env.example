# ===== LLM API（OpenAI 兼容，对应 A10.md 八、九节）=====
# 建议使用 DeepSeek / Qwen 等 OpenAI 兼容接口
# 留空或填写占位符时系统自动进入"离线演示模式"（内置演示数据集 + 教材摘录问答）
# 注意：API Key 只放 .env，不要写进源码，也不要提交 Git
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 图存储（A10.md 六、七节）=====
# auto=配置了 Neo4j 则使用（连不上自动降级 JSON）；neo4j=强制 Neo4j；json=强制 JSON 文件存储
GRAPH_STORE=auto
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ===== 应用配置（可选）=====
# RAG 检索返回的最相关文本块数量（A10.md 十五节建议 3-5）
RAG_TOP_K=4
# 文本切块大小（字），A10.md 建议 500-1000
RAG_CHUNK_SIZE=800

# ===== RAG 向量检索（可选，混合检索）=====
# 嵌入模型名：留空=不启用向量检索（纯关键词，零配置可跑）；
# 填入即对 RAG 叠加向量召回，缺省复用主 LLM 的 baseURL/Key/协议（同一 provider 的嵌入端点）。
# 例：OpenAI 兼容/DeepSeek 可填 bge-m3、Qwen 填 text-embedding-v3 等（需该服务实际提供 embeddings）。
LLM_EMBED_MODEL=
# 如需独立的嵌入端点，可单独覆盖以下项（不填则沿用主 LLM 配置）：
# LLM_EMBED_BASE_URL=
# LLM_EMBED_API_KEY=
# LLM_EMBED_KIND=            # openai-compatible|openai-chat|openai-responses|gemini（anthropic 不支持嵌入）
# 混合检索里向量分的权重 0~1（0=纯关键词，1=纯向量，默认 0.5）
RAG_VECTOR_WEIGHT=0.5
# 上传文件大小上限（字节）
MAX_FILE_SIZE=20971520
# JSON 存储目录（课程/掌握状态/图谱兜底/RAG 语料）
DATA_DIR=./data/store

# ===== 登录与角色（A-1）=====
# 会话 JWT 签名密钥：生产部署必须改为强随机值（如 openssl rand -base64 32）
AUTH_SECRET=a10-demo-secret-change-me-in-production
# 首次启动会以此播种 data/store/users.json（scrypt 哈希存储，之后可在管理后台增删改）
# 演示账号（缺省仅用于本地演示与 e2e；生产必须覆盖）
DEMO_ADMIN_USER=admin
DEMO_ADMIN_PASS=admin123456
DEMO_TEACHER_USER=teacher
DEMO_TEACHER_PASS=teach123456
DEMO_STUDENT_USER=student
DEMO_STUDENT_PASS=study123456
